{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskTime",
  "version": "0.1.0",
  "identifier": "com.desktime.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "clock",
        "title": "DeskTime Clock",
        "url": "/?panel=clock",
        "width": 282,
        "height": 202,
        "minWidth": 252,
        "minHeight": 202,
        "x": 80,
        "y": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "note",
        "title": "DeskTime Note",
        "url": "/?panel=note",
        "width": 342,
        "height": 282,
        "minWidth": 272,
        "minHeight": 222,
        "x": 80,
        "y": 270,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "schedule",
        "title": "DeskTime Schedule",
        "url": "/?panel=schedule",
        "width": 392,
        "height": 392,
        "minWidth": 332,
        "minHeight": 292,
        "x": 430,
        "y": 80,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "menu",
        "title": "DeskTime Menu",
        "url": "/?panel=menu",
        "width": 220,
        "height": 260,
        "visible": false,
        "focus": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
