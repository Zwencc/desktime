{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskTime",
  "version": "0.1.9",
  "identifier": "com.desktime.app",
  "build": {
    "beforeDevCommand": "npm run sidecars:dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run sidecars:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "clock",
        "title": "DeskTime Clock",
        "url": "/?panel=clock",
        "width": 282,
        "height": 202,
        "minWidth": 252,
        "minHeight": 202,
        "x": 80,
        "y": 80,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      },
      {
        "label": "note",
        "title": "DeskTime Note",
        "url": "/?panel=note",
        "width": 480,
        "height": 320,
        "minWidth": 360,
        "minHeight": 222,
        "x": 80,
        "y": 270,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      },
      {
        "label": "schedule",
        "title": "DeskTime Schedule",
        "url": "/?panel=schedule",
        "width": 392,
        "height": 392,
        "minWidth": 332,
        "minHeight": 292,
        "x": 430,
        "y": 80,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      },
      {
        "label": "moo",
        "title": "DeskTime Moo",
        "url": "/?panel=moo",
        "width": 340,
        "height": 420,
        "minWidth": 300,
        "minHeight": 300,
        "x": 430,
        "y": 500,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      },
      {
        "label": "reminder",
        "title": "DeskTime Reminder",
        "url": "/?panel=reminder",
        "width": 380,
        "height": 220,
        "visible": false,
        "focus": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/DTCore",
      "binaries/DTSvc"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "resources": {
      "../plugins/_template": "plugins/_template",
      "../plugins/system-monitor": "plugins/system-monitor",
      "../plugins/video-player": "plugins/video-player"
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
